---
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Главная' },
  { href: '/tools/', label: 'Инструменты' },
  { href: '/about/', label: 'О проекте' },
  { href: '/privacy/', label: 'Privacy' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="ITTOOLS — На главную">
      <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="#141413" />
        <rect x="6" y="6" width="8" height="8" rx="1.5" stroke="#F6F6F3" stroke-width="1.75" />
        <rect x="18" y="6" width="8" height="8" rx="1.5" fill="#1D4ED8" />
        <rect x="6" y="18" width="8" height="8" rx="1.5" stroke="#F6F6F3" stroke-width="1.75" />
        <path d="M18 22H26M22 18V26" stroke="#F6F6F3" stroke-width="1.75" stroke-linecap="round" />
      </svg>
      <span class="brand-name">ITTOOLS</span>
      <span class="brand-tag">v1.0</span>
    </a>

    <nav class="nav-desktop" aria-label="Основная навигация">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Открыть меню"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6H17M3 10H17M3 14H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="nav-mobile" aria-label="Мобильная навигация" hidden>
    <div class="container nav-mobile-inner">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-mobile-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      mobileNav.hidden = expanded;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: rgba(246, 246, 243, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-hairline);
  }

  .header-inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-name {
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
  }

  .brand-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface);
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-secondary);
    transition:
      color var(--t-fast) var(--ease-out),
      background-color var(--t-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink-primary);
    background-color: var(--bg-subtle);
  }

  .nav-link.active {
    color: var(--ink-primary);
    background-color: var(--bg-surface);
    box-shadow: inset 0 0 0 1px var(--border-hairline);
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    color: var(--ink-primary);
    cursor: pointer;
  }

  .nav-mobile {
    border-top: 1px solid var(--border-hairline);
    background-color: var(--bg-surface);
  }

  .nav-mobile-inner {
    display: flex;
    flex-direction: column;
    padding-block: 0.75rem;
    gap: 0.25rem;
  }

  .nav-mobile-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-secondary);
  }

  .nav-mobile-link.active {
    color: var(--accent);
    background-color: var(--accent-soft);
  }

  @media (min-width: 720px) {
    .nav-desktop {
      display: flex;
    }
    .nav-toggle,
    .nav-mobile {
      display: none !important;
    }
  }
</style>
