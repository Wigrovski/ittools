---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Страница не найдена"
  description="Запрошенная страница не найдена."
  noindex={true}
>
  <section class="container not-found">
    <div class="card nf-card">
      <span class="mono-label">ERROR 404 · NOT FOUND</span>
      <h1>Страница не найдена</h1>
      <p>
        Возможно, адрес был введён с опечаткой или страница была перемещена. Вернитесь на главную
        или перейдите сразу к инструментам.
      </p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary">На главную</a>
        <a href="/tools/" class="btn btn-secondary">К инструментам</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: clamp(4rem, 10vw, 7rem) var(--gutter);
    display: flex;
    justify-content: center;
  }

  .nf-card {
    max-width: 520px;
    width: 100%;
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .nf-card h1 {
    margin: 0.75rem 0 0.75rem;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .nf-card p {
    margin: 0 0 1.75rem;
    color: var(--ink-secondary);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
